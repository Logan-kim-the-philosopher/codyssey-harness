{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "slides"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
  "status": { "enum": ["draft", "blocked-material", "approved"] },
  "materialBlockers": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["image", "code", "terminal", "decision"] },
        "description": { "type": "string", "minLength": 1 },
        "preparation": { "type": "string" },
        "slideId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["cover", "chapter-cover", "code", "terminal", "image"] },
          "title": { "type": "string" }, "subtitle": { "type": "string" },
          "purpose": { "type": "string" }, "explanation": { "type": "string" },
          "command": { "type": "string" }, "output": { "type": "string" },
          "src": { "type": "string" }, "alt": { "type": "string" }, "caption": { "type": "string" },
          "method": { "type": "string" }, "result": { "type": "string" }, "body": { "type": "string" },
          "codeReading": { "type": "array" },
          "learning": {
            "type": "object",
            "properties": {
              "purpose": { "type": "string", "minLength": 1 },
              "codeBlocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lines", "details"],
                  "properties": {
                    "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
                    "details": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  },
                  "additionalProperties": true
                }
              }
            },
            "required": ["purpose", "codeBlocks"],
            "additionalProperties": true
          }
        }
      }
    }
  }
}
